{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "opener:default",
    "process:default",
    "notification:default",
    "os:default",
    "window-state:default",
    "deep-link:default",
    "autostart:default",
    "global-shortcut:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "llm-lab-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
