#!/usr/bin/env bash
set -euo pipefail

protected_branches="^(dev|master|main)$"
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"

if [[ "$branch" =~ $protected_branches ]]; then
    echo "error: commits directos a '$branch' están bloqueados." >&2
    echo "Crear una rama feature/fix/chore y abrir PR." >&2
    exit 1
fi
